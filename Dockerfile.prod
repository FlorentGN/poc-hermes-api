# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.prod — Build léger & autonome destiné à la production
# Secrets utilisés :
#   - ca_cert      : certificat racine de l'autorité interne
#   - gitlab_token : token d'accès GitLab pour cloner la dépendance
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

# Installation de git (requis pour pip install git+https://...)
# et des utilitaires de certificats CA
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY app/ ./app/

# Montage temporaire des secrets lors de l'étape de build :
# - /run/secrets/ca_cert : installé temporairement dans le trust store du conteneur
# - /run/secrets/gitlab_token : lu en mémoire pour configurer git insteadOf
# Aucun secret n'est conservé dans les layers ou l'image finale !
RUN --mount=type=secret,id=ca_cert,required=false \
    --mount=type=secret,id=gitlab_token,required=false \
    set -e; \
    if [ -f /run/secrets/ca_cert ]; then \
        cp /run/secrets/ca_cert /usr/local/share/ca-certificates/hermes-ca.crt; \
        update-ca-certificates; \
    fi; \
    if [ -f /run/secrets/gitlab_token ]; then \
        TOKEN=$(cat /run/secrets/gitlab_token | tr -d '\r\n'); \
        # Supporte à la fois un PAT/Deploy Token et un CI_JOB_TOKEN (gitlab-ci-token)
        git config --global url."https://gitlab-ci-token:${TOKEN}@gitlab.hermes.lan/".insteadOf "https://gitlab.hermes.lan/" || \
        git config --global url."https://oauth2:${TOKEN}@gitlab.hermes.lan/".insteadOf "https://gitlab.hermes.lan/"; \
    fi; \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir . && \
    # Nettoyage de la configuration Git et du CA temporaire
    git config --global --unset-all url."https://oauth2:${TOKEN}@gitlab.hermes.lan/".insteadOf 2>/dev/null || true; \
    rm -f /usr/local/share/ca-certificates/hermes-ca.crt && update-ca-certificates 2>/dev/null || true

# ─────────────────────────────────────────────────────────────────────────────
# Stage Final Runtime (sans git ni outils de build, très léger)
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS runner

WORKDIR /app

# Copie des packages installés depuis le builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY app/ ./app/

# Utilisateur non-root pour la sécurité
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Démarrage avec uvicorn en mode production (sans reload)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]

